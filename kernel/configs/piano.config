# piano / SM8750 config fragment — merged on top of arm64 defconfig.
#
# Everything here is justified by the factory device tree (docs/KERNEL-TRUTH.md);
# no third-party config file was copied. Unknown symbols are reported by
# scripts/kconfig/merge_config.sh in CI and must be fixed, not ignored.

# --- base ---------------------------------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_XZ=y

# --- firmware loading (ADSP/WLAN/GPU blobs come from the stock firmware) --
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_EXTRA_FIRMWARE=""

# --- storage: UFS 4.0 + MCQ --------------------------------------------
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_PHY_QCOM_UFS=y

# --- interconnect / clocks / pinctrl / thermal --------------------------
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_PINCTRL_SM8750=y
CONFIG_INTERCONNECT_QCOM_SM8750=y

# --- display: DPU + two DSI links (DSC, 3200x2136@144) ------------------
# DRM stays modular: DRM_KMS_HELPER is a hidden symbol whose value Kconfig
# recomputes from select expressions, so forcing it =y to satisfy a built-in
# DRM_MSM does not hold and vmlinux links with undefined bridge-state helpers.
# Debian/Kali ship drm + msm as modules too; initramfs loads them.
# DRM must be built in: the fast path ships no modules, and a modular msm means
# the kernel has no display driver at all (black screen, no fbcon).
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_MSM=y
# These two bridges were what pulled in the undefined drm_atomic_helper_bridge_*
# symbols when DRM_MSM was built in; keep them out.
# CONFIG_DRM_AUX_BRIDGE is not set
# CONFIG_DRM_AUX_HPD_BRIDGE is not set
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y

# --- touch / keyboard / keys -------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_OF=y

# --- USB / Type-C / UCSI -------------------------------------------------
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_TYPEC=y
# QCOM_PMIC_GLINK selects DRM_AUX_HPD_BRIDGE, whose built-in object needs
# drm_kms_helper symbols that olddefconfig keeps as a module; that broke the
# vmlinux link. Charging is not needed to bring the display up, so UCSI stays
# module-only (built with the full build) until the helper question is settled.
# CONFIG_UCSI_GLINK is not set
# CONFIG_QCOM_PMIC_GLINK is not set
CONFIG_TYPEC_UCSI=y

# --- PCIe0 -> WCN7850 (ath12k) ------------------------------------------
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_ATH12K=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_QCA=m

# --- audio: qcom,sm8750-sndcard + TDM + LPASS macros + external amps -----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_WCD939X=y
CONFIG_SND_SOC_WCD939X_SDW=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_APR=y

# --- power supply / charging -------------------------------------------
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BQ27XXX=y

# --- memory / swap ------------------------------------------------------
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# --- debug aids (keep, this is a bring-up kernel) -----------------------
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y

# --- build-time trim: subsystems v1 does not use -------------------------
# arm64 defconfig enables these as modules; each pulls hundreds of objects
# that never run on this tablet (no camera, no SATA, no InfiniBand, no DVB).
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DVB_CORE is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ATA is not set
# CONFIG_HAMRADIO is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_TI is not set

# --- early debug: kernel log on the panel via the bootloader framebuffer ----
# There is no UART on this tablet, and the panel driver is not written yet, so
# simplefb + fbcon is the only way to see a panic.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
