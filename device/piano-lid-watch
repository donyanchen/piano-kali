#!/usr/bin/env python3
"""piano 合盖熄屏。

键盘套合盖时 pogo 触点断开 -> nanosic_hinge/keyboard_attached 1->0
部分固件还会发 SW_LID。两条都监听：
  - 合盖：锁屏 + DPMS off
  - 开盖：DPMS on（不自动解锁，防止误开）
"""
import os
import struct
import subprocess
import threading
import time

HINGE = "/sys/class/misc/nanosic_hinge/keyboard_attached"
EVDEV = "/dev/input/event2"
CLOSE_DELAY = 2.0          # 合盖判定延迟，避免瞬断误触发
ENV = dict(os.environ)
ENV.setdefault("XDG_RUNTIME_DIR", "/run/user/1000")
ENV.setdefault("WAYLAND_DISPLAY", "wayland-0")

_lock = threading.Lock()
_state = {"closed": False}


def run(*args):
    try:
        subprocess.run(args, env=ENV, timeout=8,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def do_close():
    with _lock:
        if _state["closed"]:
            return
        _state["closed"] = True
    print("lid closed -> lock + dpms off", flush=True)
    run("loginctl", "lock-session")
    time.sleep(0.4)
    run("kscreen-doctor", "--dpms", "off")


def do_open():
    with _lock:
        if not _state["closed"]:
            return
        _state["closed"] = False
    print("lid open -> dpms on", flush=True)
    run("kscreen-doctor", "--dpms", "on")


def hinge_monitor():
    """轮询 keyboard_attached：1=键盘连着(开盖) 0=断开(合盖)。"""
    prev = None
    while True:
        try:
            with open(HINGE) as f:
                cur = f.read().strip()
        except OSError:
            time.sleep(1)
            continue
        if prev is not None and cur != prev:
            if cur == "0":
                # 延迟确认，避免只是抖一下
                time.sleep(CLOSE_DELAY)
                try:
                    with open(HINGE) as f:
                        if f.read().strip() == "0":
                            do_close()
                except OSError:
                    pass
            else:
                do_open()
        prev = cur
        time.sleep(0.3)


def evdev_monitor():
    """SW_LID（EV_SW code 0）：1=合 0=开。有些固件只有这条。"""
    try:
        fd = os.open(EVDEV, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as e:
        print("evdev unavailable: %s" % e, flush=True)
        return
    while True:
        try:
            data = os.read(fd, 24)
        except BlockingIOError:
            time.sleep(0.1)
            continue
        except OSError:
            time.sleep(1)
            continue
        if len(data) < 24:
            continue
        _s, _u, typ, code, value = struct.unpack("llHHi", data[:24])
        if typ == 0x05 and code == 0x00:
            if value == 1:
                do_close()
            else:
                do_open()


DPMS = "/sys/class/drm/card1-DSI-1/dpms"
_touch_lock = {"last": 0.0}


def reset_touch(reason):
    """唤醒后重置触摸流；3 秒内只做一次，避免重复重启。"""
    now = time.time()
    if now - _touch_lock["last"] < 3.0:
        return
    _touch_lock["last"] = now
    print("touch reset (%s)" % reason, flush=True)
    run("sudo", "-n", "/usr/local/bin/piano-restart-touch")


def dpms_monitor():
    """DPMS Off -> On 代表屏幕被唤醒（合盖/电源键/活动唤醒都覆盖）。"""
    prev = None
    while True:
        try:
            with open(DPMS) as f:
                cur = f.read().strip()
        except OSError:
            time.sleep(1)
            continue
        if prev == "Off" and cur == "On":
            time.sleep(0.5)
            reset_touch("dpms on")
        prev = cur
        time.sleep(0.5)


if __name__ == "__main__":
    threading.Thread(target=hinge_monitor, daemon=True).start()
    threading.Thread(target=evdev_monitor, daemon=True).start()
    threading.Thread(target=dpms_monitor, daemon=True).start()
    print("piano-lid watching %s, %s, %s" % (HINGE, EVDEV, DPMS), flush=True)
    while True:
        time.sleep(60)
