#!/bin/bash
# piano 并发热点：wlan0 保持 STA，wlan1 做 AP
# 开关热点用 hostapd_cli enable/disable，避免反复启停 hostapd 触发段错误
SSID=${SSID:-Piano-AP}
PASS=${PASS:-piano12345}
CHAN=${CHAN:-6}
GW=10.42.0.1
APIF=wlan1

[ -f /etc/piano/hotspot.conf ] && . /etc/piano/hotspot.conf
mkdir -p /run/sheng-hotspot /var/run/hostapd

STA_MAC=$(cat /sys/class/net/wlan0/address)
APMAC=$(python3 - "$STA_MAC" <<'PY'
import sys
m = sys.argv[1].split(':')
m[-1] = f"{(int(m[-1],16) ^ 0x02) & 0xff:02x}"
print(':'.join(m))
PY
)

hostapd_running() { pgrep -f "hostapd /etc/hostapd/wlan1.conf" >/dev/null 2>&1; }

# 已在运行：只做 enable
if hostapd_running; then
    hostapd_cli -p /var/run/hostapd -i "$APIF" enable >/dev/null 2>&1 || true
    touch /run/sheng-hotspot/ready
    exit 0
fi

pkill -f "dnsmasq.*wlan1" 2>/dev/null || true
[ -f /run/dnsmasq-wlan1.pid ] && kill "$(cat /run/dnsmasq-wlan1.pid)" 2>/dev/null || true

if ip link show "$APIF" >/dev/null 2>&1; then
    ip link set "$APIF" down 2>/dev/null || true
    iw dev "$APIF" del 2>/dev/null || true
    sleep 1
fi

iw dev wlan0 interface add "$APIF" type __ap || exit 1
nmcli device set "$APIF" managed no 2>/dev/null || true

# 新接口会继承 wlan0 的 MAC，必须改成唯一地址；改失败就重试
for i in 1 2 3 4 5; do
    ip link set "$APIF" down 2>/dev/null || true
    ip link set "$APIF" address "$APMAC" 2>/dev/null || true
    CUR=$(cat "/sys/class/net/$APIF/address" 2>/dev/null)
    [ "$CUR" != "$STA_MAC" ] && break
    sleep 0.4
done
CUR=$(cat "/sys/class/net/$APIF/address" 2>/dev/null)
if [ "$CUR" = "$STA_MAC" ]; then
    echo "ap mac could not be changed" >&2
    exit 1
fi
ip link set "$APIF" up 2>/dev/null || { echo "ap iface up failed" >&2; exit 1; }

cat > /etc/hostapd/wlan1.conf <<EOF
interface=$APIF
driver=nl80211
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0
ssid=$SSID
hw_mode=g
channel=$CHAN
ieee80211n=1
wpa=2
wpa_passphrase=$PASS
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF

hostapd -B /etc/hostapd/wlan1.conf || exit 1
sleep 2

ip addr replace $GW/24 dev "$APIF" 2>/dev/null || true
dnsmasq --interface="$APIF" --dhcp-range=10.42.0.10,10.42.0.100,12h \
        --except-interface=lo --bind-interfaces \
        --pid-file=/run/dnsmasq-wlan1.pid --conf-file=/dev/null 2>/dev/null || true

sysctl -qw net.ipv4.ip_forward=1
nft list table ip nat >/dev/null 2>&1 || nft add table ip nat
nft list chain ip nat postrouting >/dev/null 2>&1 || \
    nft 'add chain ip nat postrouting { type nat hook postrouting priority 100; }'
nft list ruleset | grep -q 'oifname "wlan0" masquerade' || \
    nft add rule ip nat postrouting oifname "wlan0" masquerade

touch /run/sheng-hotspot/ready
exit 0
