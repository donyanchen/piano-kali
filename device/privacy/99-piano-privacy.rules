SUBSYSTEM=="sound", KERNEL=="pcmC*D*c", TEST=="/var/lib/piano-privacy/blocked", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess", RUN+="/usr/libexec/piano-privacy-bpf deny %M %m"
SUBSYSTEM=="sound", KERNEL!="pcmC*D*c", ENV{MAJOR}=="?*", TEST=="/var/lib/piano-privacy/blocked", RUN+="/usr/libexec/piano-privacy-bpf allow %M %m"
SUBSYSTEM=="video4linux", DRIVERS=="qcom-camss", TEST=="/var/lib/piano-privacy/blocked", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess", RUN+="/usr/libexec/piano-privacy-bpf deny %M %m"
SUBSYSTEM=="video4linux", DRIVERS=="uvcvideo", TEST=="/var/lib/piano-privacy/blocked", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess", RUN+="/usr/libexec/piano-privacy-bpf deny %M %m"
SUBSYSTEM=="video4linux", DRIVERS=="qcom-iris", TEST=="/var/lib/piano-privacy/blocked", RUN+="/usr/libexec/piano-privacy-bpf allow %M %m"
SUBSYSTEM=="gnss", TEST=="/var/lib/piano-privacy/blocked", OWNER="root", GROUP="root", MODE="0600", TAG-="uaccess", RUN+="/usr/libexec/piano-privacy-bpf deny-major %M"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", TEST=="/var/lib/piano-privacy/blocked", IMPORT{builtin}="usb_id"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:0e????:*", TEST=="/var/lib/piano-privacy/blocked", RUN+="/usr/libexec/piano-privacy-bpf deny %M %m"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:01????:*", TEST=="/var/lib/piano-privacy/blocked", RUN+="/usr/libexec/piano-privacy-bpf deny %M %m"
