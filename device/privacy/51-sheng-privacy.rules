polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") === "sheng-privacy@on.service" || action.lookup("unit") === "sheng-privacy@off.service") &&
        action.lookup("verb") === "start" && subject.user === "kali" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
