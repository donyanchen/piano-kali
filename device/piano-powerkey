#!/usr/bin/env python3
"""Power key: short press toggles the panel DPMS (Android-like screen off/on)."""
import os
import re
import struct
import subprocess
import time

ENV = {
    'XDG_RUNTIME_DIR': '/run/user/1000',
    'WAYLAND_DISPLAY': 'wayland-0',
    'DISPLAY': ':0',
}
STATE = '/run/piano-dpms-off'
KEY_POWER = 116
EV_KEY = 1


def key_bitmask():
    blocks = open('/proc/bus/input/devices').read().split('\n\n')
    for block in blocks:
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        keys = re.search(r'^B: KEY=(.*)$', block, re.M)
        events = re.search(r'^H: Handlers=.*?(event\d+)', block, re.M)
        if not (name and keys and events):
            continue
        words = keys.group(1).split()
        mask = 0
        for i, word in enumerate(reversed(words)):
            mask |= int(word, 16) << (64 * i)
        if mask >> KEY_POWER & 1:
            yield name.group(1), '/dev/input/' + events.group(1)


def dpms(turn_off):
    subprocess.run(['runuser', '-u', 'kali', '--', 'env',
                    'XDG_RUNTIME_DIR=' + ENV['XDG_RUNTIME_DIR'],
                    'WAYLAND_DISPLAY=' + ENV['WAYLAND_DISPLAY'],
                    'kscreen-doctor', '--dpms', 'off' if turn_off else 'on'],
                   check=False)


def main():
    dev = None
    for name, path in key_bitmask():
        print('power key candidate:', name, path, flush=True)
        if 'pwr' in name.lower() or 'gpio' in name.lower() or dev is None:
            dev = path
    if not dev:
        print('no power key device', flush=True)
        return
    print('using', dev, flush=True)
    fmt = 'llHHi'
    size = struct.calcsize(fmt)
    with open(dev, 'rb', buffering=0) as fd:
        while True:
            data = fd.read(size)
            if not data:
                time.sleep(0.2)
                continue
            _, _, etype, code, value = struct.unpack(fmt, data)
            if etype != EV_KEY or code != KEY_POWER or value != 1:
                continue
            off = os.path.exists(STATE)
            dpms(not off)
            if off:
                os.remove(STATE)
            else:
                open(STATE, 'w').close()
            print('power key: dpms', 'on' if off else 'off', flush=True)


if __name__ == '__main__':
    main()
