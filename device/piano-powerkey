#!/usr/bin/env python3
"""Own power-key policy for the piano tablet.

Short press: lock the session (the lock screen blanks immediately, so it feels
like screen off). Long press (>= 1.2 s): Xiaomi-style power menu.

KDE's own power-button action is disabled so only this watcher reacts.
"""
import os
import re
import struct
import subprocess
import time

KEY_POWER = 116
EV_KEY = 1
HOLD_SECONDS = 1.2
ENV = ['XDG_RUNTIME_DIR=/run/user/1000', 'WAYLAND_DISPLAY=wayland-0', 'DISPLAY=:0']


def power_key_devices():
    for block in open('/proc/bus/input/devices').read().split('\n\n'):
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        keys = re.search(r'^B: KEY=(.*)$', block, re.M)
        events = re.search(r'^H: Handlers=.*?(event\d+)', block, re.M)
        if not (name and keys and events):
            continue
        mask = 0
        for i, word in enumerate(reversed(keys.group(1).split())):
            mask |= int(word, 16) << (64 * i)
        if mask >> KEY_POWER & 1:
            yield name.group(1), '/dev/input/' + events.group(1)


STATE = '/run/piano-power-off'


def dpms(on):
    subprocess.run(['runuser', '-u', 'kali', '--', 'env'] + ENV +
                   ['kscreen-doctor', '--dpms', 'on' if on else 'off'], check=False)


def short_press():
    # First press: lock and blank the panel. Second press: wake only.
    if os.path.exists(STATE):
        dpms(True)
        os.remove(STATE)
        return
    subprocess.run(['loginctl', 'lock-sessions'], check=False)
    dpms(False)
    open(STATE, 'w').close()


def long_press():
    """Long press wakes the panel and shows Plasma's leave/power menu."""
    dpms(True)
    if os.path.exists(STATE):
        os.remove(STATE)
    subprocess.run(['runuser', '-u', 'kali', '--', 'env'] + ENV +
                   ['qdbus6', 'org.kde.LogoutPrompt', '/LogoutPrompt',
                    'org.kde.LogoutPrompt.promptAll'], check=False)



def main():
    dev = None
    # The unit may start before the input devices are registered.
    for _ in range(30):
        for name, path in power_key_devices():
            if 'pwr' in name.lower() or dev is None:
                dev = path
        if dev:
            break
        time.sleep(2)
    if not dev:
        print('no power key device', flush=True)
        return
    fmt = 'llHHi'
    size = struct.calcsize(fmt)
    pressed_at = None
    with open(dev, 'rb', buffering=0) as fd:
        while True:
            data = fd.read(size)
            if not data:
                time.sleep(0.2)
                continue
            _, _, etype, code, value = struct.unpack(fmt, data)
            if etype != EV_KEY or code != KEY_POWER:
                continue
            if value == 1:
                pressed_at = time.time()
                print('press', flush=True)
            elif value == 0 and pressed_at is not None:
                held = time.time() - pressed_at
                print('release after %.2fs' % held, flush=True)
                if held >= HOLD_SECONDS:
                    print('-> long', flush=True)
                    long_press()
                else:
                    print('-> short', flush=True)
                    short_press()
                pressed_at = None


if __name__ == '__main__':
    main()
