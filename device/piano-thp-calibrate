#!/bin/sh
# Install the piano touchscreen calibration on first boot.
#
# The calibration is unit/panel specific and is not redistributable, so the
# image carries two private JSONs (CSOT/BOE) supplied at build time; this unit
# only copies the one matching the panel the kernel reports. If neither JSON is
# present, fall back to extracting it from a stock ODM block device, which only
# exists on units that expose odm as a real partition.
set -eu
target=/etc/piano/thp-calibration.json
[ -e "$target" ] && exit 0
mkdir -p /etc/piano

vendor=csot
for node in /sys/class/misc/nvt-thp-*; do
    [ -e "$node/device/panel_vendor" ] || continue
    value=$(cat "$node/device/panel_vendor")
    [ "$value" = boe ] && vendor=boe
done
echo "piano-thp-calibrate: panel vendor $vendor"

if [ -s "/usr/share/piano/thp-$vendor.json" ]; then
    install -m 600 "/usr/share/piano/thp-$vendor.json" "$target"
    echo "piano-thp-calibrate: installed built-in $vendor calibration"
    systemctl try-restart piano-thp.service 2>/dev/null || true
    exit 0
fi

dev=/dev/disk/by-partlabel/odm
if [ ! -e "$dev" ]; then
    echo "piano-thp-calibrate: no built-in calibration and no odm partition"
    echo "piano-thp-calibrate: copy the JSON to /etc/piano/thp-calibration.json and restart piano-thp"
    exit 0
fi
mkdir -p /run/piano-odm
mount -o ro "$dev" /run/piano-odm || { echo "piano-thp-calibrate: odm not mountable"; exit 0; }
ini=$(find /run/piano-odm -name "piano_nova_${vendor}_thp_config.ini" 2>/dev/null | head -n 1)
[ -n "$ini" ] || ini=$(find /run/piano-odm -name 'piano_nova_*_thp_config.ini' 2>/dev/null | head -n 1)
if [ -n "$ini" ]; then
    python3 /usr/lib/piano/extract-thp-calibration.py --input "$ini" --output "$target" \
        && chmod 600 "$target" && echo "piano-thp-calibrate: extracted from $ini"
fi
umount /run/piano-odm || true
systemctl try-restart piano-thp.service 2>/dev/null || true
