[Unit]
Description=Piano concurrent Wi-Fi hotspot
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /usr/libexec/piano-hotspot/setup.py
ExecStart=/usr/bin/python3 /usr/libexec/piano-hotspot/hotspot.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=piano-hotspot
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
