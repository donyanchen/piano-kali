# /etc/fstab for Kali on the Xiaomi Pad 8 Pro (piano).
# The Kali root filesystem lives on the partition the upstream boot.img already
# expects: PARTLABEL=linux_rootfs. That partition is the former Android
# `userdata` entry, renamed with sgdisk before flashing (docs/INSTALL.md 3a).
# The `ipados` partition used by UniXNU is never referenced here.
PARTLABEL=linux_rootfs / ext4 defaults,noatime 0 1
