#!/bin/sh
set -eu
case "$1" in
  pre)
    if systemctl is-active --quiet piano-hotspot.service; then
        touch /run/piano-hotspot-resume
        systemctl stop piano-hotspot.service
    fi
    ;;
  post)
    if [ -f /run/piano-hotspot-resume ]; then
        rm -f /run/piano-hotspot-resume
        systemctl start --no-block piano-hotspot.service
    fi
    ;;
esac
