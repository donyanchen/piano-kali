+/* Never wait for a userspace/TEE response in the IRQ thread. */
+static void nanosic_wn8030_auth_start_worker(struct work_struct *work)
+{
+	struct nanosic_wn8030 *nanosic = container_of(work,
+		struct nanosic_wn8030, auth_start_work.work);
+	int ret;
+
+	if (!READ_ONCE(nanosic->ready) || !READ_ONCE(nanosic->auth_open) ||
+	    !READ_ONCE(nanosic->keyboard_attached) || READ_ONCE(nanosic->suspended))
+		return;
+	if (work_busy(&nanosic->auth_reply_work)) {
+		mod_delayed_work(system_percpu_wq, &nanosic->auth_start_work,
+				 msecs_to_jiffies(250));
+		return;
+	}
+	ret = nanosic_wn8030_xm_auth_init(nanosic);
+	if (ret) {
+		dev_warn_ratelimited(nanosic->dev, "keyboard auth start failed: %d\n", ret);
+		mod_delayed_work(system_percpu_wq, &nanosic->auth_start_work,
+				 msecs_to_jiffies(1000));
+	}
+}
+
+static void nanosic_wn8030_auth_reply_worker(struct work_struct *work)
+{
+	struct nanosic_wn8030 *nanosic = container_of(work,
+		struct nanosic_wn8030, auth_reply_work);
+	long completed;
+	int ret;
+
+	completed = wait_for_completion_interruptible_timeout(
+		&nanosic->auth_token_ready, msecs_to_jiffies(5000));
+	if (!READ_ONCE(nanosic->ready) || !READ_ONCE(nanosic->auth_open) ||
+	    !READ_ONCE(nanosic->keyboard_attached) || READ_ONCE(nanosic->suspended))
+		goto out;
+	if (completed <= 0) {
+		dev_warn_ratelimited(nanosic->dev, "keyboard auth response timed out\n");
+		mod_delayed_work(system_percpu_wq, &nanosic->auth_start_work,
+				 msecs_to_jiffies(1000));
+		goto out;
+	}
+	ret = nanosic_wn8030_xm_auth_s5t1(nanosic, nanosic->auth_token);
+	if (ret) {
+		dev_warn_ratelimited(nanosic->dev, "keyboard auth send failed: %d\n", ret);
+		mod_delayed_work(system_percpu_wq, &nanosic->auth_start_work,
+				 msecs_to_jiffies(1000));
+	} else {
+		nanosic->auth_responses++;
+		dev_info(nanosic->dev, "keyboard authentication response submitted\n");
+		mutex_lock(&nanosic->conn_mutex);
+		nanosic_wn8030_sync_kbd_backlight(nanosic);
+		mutex_unlock(&nanosic->conn_mutex);
+	}
+out:
+	WRITE_ONCE(nanosic->auth_request_pending, false);
+}
