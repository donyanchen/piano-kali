[Unit]
Description=Xiaomi piano keyboard authentication
After=systemd-udevd.service
ConditionPathExists=/dev/tee0
ConditionPathExists=/dev/nanosic_auth
ConditionPathExists=/usr/lib/firmware/qcom/sm8550/piano/devauth.mbn
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/libexec/piano-devauth
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
