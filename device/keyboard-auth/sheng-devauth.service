[Unit]
Description=Xiaomi sheng keyboard authentication
After=systemd-udevd.service
ConditionPathExists=/dev/tee0
ConditionPathExists=/dev/nanosic_auth
ConditionPathExists=/usr/lib/firmware/qcom/sm8550/sheng/devauth.mbn
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/libexec/sheng-devauth
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
