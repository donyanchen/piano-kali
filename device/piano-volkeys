#!/usr/bin/env python3
"""Handle the hardware volume keys ourselves.

The piano exposes the rocker as two separate devices: pmic_resin carries
KEY_VOLUMEDOWN and gpio-keys carries KEY_VOLUMEUP (plus the keyboard's own
keys). plasma-pa's kmix component has no handler here, so drive PipeWire
directly and multiplex the event nodes with select().
"""
import os
import re
import select
import struct
import subprocess
import time

EV_KEY = 1
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
KEY_MUTE = 113
WANTED = (KEY_VOLUMEDOWN, KEY_VOLUMEUP, KEY_MUTE)
ENV = dict(os.environ, XDG_RUNTIME_DIR='/run/user/1000')


def mask_of(block):
    m = re.search(r'^B: KEY=(.*)$', block, re.M)
    if not m:
        return 0
    mask = 0
    for i, word in enumerate(reversed(m.group(1).split())):
        mask |= int(word, 16) << (64 * i)
    return mask


def devices():
    out = []
    for block in open('/proc/bus/input/devices').read().split('\n\n'):
        ev = re.search(r'^H: Handlers=.*?(event\d+)', block, re.M)
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        if not ev or not name:
            continue
        mask = mask_of(block)
        if any(mask >> c & 1 for c in WANTED):
            out.append(('/dev/input/' + ev.group(1), name.group(1)))
    return out


def run(args):
    subprocess.run(args, check=False, env=ENV)


def main():
    devs = devices()
    fds = {}
    for path, name in devs:
        try:
            fds[open(path, 'rb', buffering=0)] = name
            print('volume keys:', name, path, flush=True)
        except OSError as exc:
            print('skip', path, exc, flush=True)
    if not fds:
        print('no volume key device', flush=True)
        return
    fmt = 'llHHi'
    size = struct.calcsize(fmt)
    while True:
        ready, _, _ = select.select(list(fds), [], [], 2.0)
        for fd in ready:
            data = fd.read(size)
            if not data:
                time.sleep(0.05)
                continue
            _, _, etype, code, value = struct.unpack(fmt, data)
            if etype != EV_KEY or value != 1:
                continue
            if code == KEY_VOLUMEUP:
                run(['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', '5%+'])
            elif code == KEY_VOLUMEDOWN:
                run(['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', '5%-'])
            elif code == KEY_MUTE:
                run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', 'toggle'])


if __name__ == '__main__':
    main()
