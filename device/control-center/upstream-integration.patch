+#!/bin/bash
+set -euo pipefail
+case "${1:-}" in
+    on)
+        systemctl start sheng-hotspot.service
+        for ((i=0; i<60; i++)); do
+            if [[ -f /run/sheng-hotspot/ready ]]; then printf 'ready\n'; exit 0; fi
+            if systemctl is-failed --quiet sheng-hotspot.service; then exit 1; fi
+            sleep 0.2
+        done
+        exit 1
+        ;;
+    off) systemctl stop sheng-hotspot.service ;;
+    *) exit 2 ;;
+esac
